# Mobile environment — copy to .env (gitignored) and fill before running.
#
# EXPO_PUBLIC_* values are inlined into the JS bundle, so they are
# considered PUBLIC. Never put server secrets (DB URL, etc.) here.
# For per-environment values (dev/staging/prod) use the EAS env block
# inside eas.json instead.

EXPO_PUBLIC_API_URL=https://epetrecere.md/api/v1
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional (M5)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
