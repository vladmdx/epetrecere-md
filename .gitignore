# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# uploaded files (local dev)
/public/uploads

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# playwright
/test-results/
/e2e-report/
/e2e/.auth/
/playwright-report/

# Apple credentials (.p8 keys)
packages/mobile/credentials/
*.p8

packages/mobile/build-*.ipa

# iCloud duplicate files. Syncing this repo from iCloud Drive occasionally
# leaves a second copy of a file named "<name> 2.<ext>" beside the original.
# They are never real source; keeping them out stops `git add -A` from
# committing a stale fork of a script nobody edited.
*\ 2.ts
*\ 2.tsx
*\ 2.mjs
*\ 2.json
*\ 2.md

# iCloud duplicates. Syncing this repo from iCloud Drive periodically leaves
# "<name> 2.ext" copies next to the originals — byte-identical, invisible in
# an editor's file tree, and picked up by `git add -A`. Several were committed
# that way before this rule existed.
*\ 2.*
*\ 3.*
