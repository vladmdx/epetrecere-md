# ePetrecere.md — environment template
# ---------------------------------------------------------------------------
# Copy to `.env` (web, repo root) and fill in. Vars are grouped by service.
# NEXT_PUBLIC_* are inlined into the browser bundle — never put secrets there.
# The mobile app uses its own EXPO_PUBLIC_* set (see the bottom section) and
# reads them from packages/mobile/.env.
#
# Names below are the ones actually referenced in the code. Optional services
# degrade gracefully when unset (search/email/push/maps become no-ops), but
# the ones marked REQUIRED must be present for the app to boot.
# ===========================================================================

# ── Core / Database (REQUIRED) ─────────────────────────────────────────────
DATABASE_URL=                       # Neon Postgres connection string
NEXT_PUBLIC_APP_URL=http://localhost:3000   # absolute base for emails/SEO/OAuth redirect
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # canonical site URL (sitemap/SEO)

# ── Auth — Clerk (REQUIRED) ────────────────────────────────────────────────
CLERK_SECRET_KEY=                   # sk_test_… / sk_live_…
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=  # pk_test_… / pk_live_… (read implicitly by @clerk/nextjs)
CLERK_WEBHOOK_SECRET=               # Svix signing secret for /api/webhooks/clerk

# ── AI ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                  # REQUIRED for all AI features (else 503)
OPENAI_API_KEY=                     # Whisper STT (voice → text). Currently PENDING on Vercel.

# ── Rate limiting / cron / monitoring ──────────────────────────────────────
UPSTASH_REDIS_REST_URL=             # rate limiting (falls back to in-memory on dev)
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=                        # Bearer token guarding /api/cron/* (set on Vercel)
ANALYTICS_SALT=                     # salt for hashing IPs in profile analytics

# Sentry (server + edge use SENTRY_*, browser uses NEXT_PUBLIC_SENTRY_*)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ORG=                         # build-time source map upload
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Email / notifications ──────────────────────────────────────────────────
RESEND_API_KEY=                     # transactional email
EMAIL_FROM=                         # e.g. "ePetrecere <noreply@epetrecere.md>"

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                      # mailto:you@epetrecere.md

# WhatsApp Business Cloud API (Meta Graph) — critical-event notifications only
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=

# ── Storage — pick ONE backend (Cloudflare R2 is what upload.ts implements) ─
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=                      # public base URL for uploaded objects
BLOB_READ_WRITE_TOKEN=              # alternative: Vercel Blob (used by /api/upload)

# ── Search — Meilisearch (optional; no-op when unset) ──────────────────────
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# ── Integrations ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                   # Google Calendar OAuth (vendor availability sync)
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=              # maps / place lookups
ICAL_SECRET=                        # signs iCal feed URLs (falls back to CLERK_SECRET_KEY)

# Inngest (background jobs) — required in prod; read implicitly by the SDK
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Public display config ──────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_PHONE=          # shown in footer/contact
NEXT_PUBLIC_EUR_MDL_RATE=           # EUR→MDL rate for price display

# ── Dev / test login (see src/app/api/dev/sign-in-token/route.ts) ──────────
# ENABLE_TEST_LOGIN=1 turns on the password-less /test-login demo. In
# production it ALSO requires TEST_LOGIN_SECRET, and the demo link must carry
# it as ?key=<secret>. Leave both unset in normal prod.
ENABLE_TEST_LOGIN=
TEST_LOGIN_SECRET=

# ===========================================================================
# MOBILE (packages/mobile/.env) — EXPO_PUBLIC_* are inlined into the app bundle
# ===========================================================================
# EXPO_PUBLIC_API_URL=https://epetrecere.md/api/v1
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_…
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_POSTHOG_KEY=
